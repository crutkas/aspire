# Polyglot Dockerfile for Java AppHost E2E tests.
# Extends the shared polyglot base with the JDK required by Java AppHosts.

FROM aspire-e2e-polyglot-base

COPY tests/Shared/Docker/apt-retry.sh /usr/local/bin/apt-retry
RUN chmod +x /usr/local/bin/apt-retry

RUN apt-retry install openjdk-25-jdk && \
    rm -rf /var/lib/apt/lists/*
